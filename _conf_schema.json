{
  "basic": {
    "description": "基础设置",
    "type": "object",
    "hint": "群聊权限是第一道门槛，不通过就不会运行任何插件功能。whitelist + 空列表 = 不会开启任何功能。",
    "items": {
      "group_list_mode": {
        "description": "群聊权限模式",
        "type": "string",
        "options": [
          "whitelist",
          "blacklist",
          "none"
        ],
        "default": "none",
        "hint": "先决定「哪些群可以用这个插件」。这是第一道门槛：不通过这里，所有命令都不会响应。whitelist=只允许列表里的群；blacklist=屏蔽列表里的群；none=所有群都可以。示例：whitelist + [\"onebot:GroupMessage:123456\"] 表示只有这个群能用。"
      },
      "group_list": {
        "type": "list",
        "description": "群组白/黑名单列表",
        "default": [],
        "hint": "要填的群列表。可以填完整会话ID（如 onebot:GroupMessage:123456）或只填群号（如 123456）。新手建议优先填完整会话ID，更不容易填错。可用 /sid 获取当前会话ID。",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "llm": {
    "description": "LLM 设置",
    "type": "object",
    "items": {
      "llm_provider_id": {
        "type": "string",
        "description": "LLM Provider ID（用于所有分析任务）",
        "_special": "select_provider",
        "default": "",
        "hint": "选择用于魔法少女转生人物卡生成的 LLM Provider。留空则使用当前会话的默认 Provider。"
      },
      "llm_retries": {
        "type": "int",
        "description": "LLM 重试次数",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 5,
          "step": 1
        }
      },
      "llm_backoff": {
        "type": "int",
        "description": "LLM 重试退避秒数",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      }
    }
  },
  "adventure": {
    "description": "魔法少女转生卡设置",
    "type": "object",
    "items": {
      "diary_compress_interval": {
        "type": "int",
        "description": "每 N 次战斗触发一次战斗记录压缩",
        "default": 10,
        "hint": "普通未压缩战斗记录达到这个数量后，自动调用 AI 压缩更早的记录。填 0 表示关闭压缩。",
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        }
      },
      "diary_compress_count": {
        "type": "int",
        "description": "每次压缩 M 条旧战斗记录",
        "default": 6,
        "hint": "触发压缩时，把最早的 M 条普通战斗日记压缩成一条范围摘要，例如第 1-6 次战斗。",
        "slider": {
          "min": 1,
          "max": 50,
          "step": 1
        }
      },
      "cameo_compress_interval": {
        "type": "int",
        "description": "每 N 条交互记录触发一次压缩",
        "default": 10,
        "hint": "其他人与主角的交互记录达到这个数量后，自动调用 AI 压缩更早的记录。填 0 表示关闭压缩。",
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        }
      },
      "cameo_compress_count": {
        "type": "int",
        "description": "每次压缩 M 条旧交互记录",
        "default": 6,
        "hint": "触发压缩时，把最早的 M 条交互记录压缩成一条范围摘要。",
        "slider": {
          "min": 1,
          "max": 50,
          "step": 1
        }
      },
      "debug_mode": {
        "type": "bool",
        "description": "调试模式",
        "default": false,
        "hint": "开启后会在插件数据目录保存 prompt 与 LLM 原始响应。"
      },
      "use_mock_data": {
        "type": "bool",
        "description": "使用静态假数据",
        "default": false,
        "hint": "用于先验证 HTML 转图片和发图链路；不会调用人物卡 LLM。"
      }
    }
  },
  "t2i_rendering": {
    "description": "图片渲染策略",
    "type": "object",
    "hint": "配置 HTML 转图片的渲染参数。第一轮优先质量，第二轮作为回退。",
    "items": {
      "t2i_r1_type": {
        "type": "string",
        "description": "第一轮：图片格式",
        "options": ["jpeg", "png"],
        "default": "png"
      },
      "t2i_r1_quality": {
        "type": "int",
        "description": "第一轮：图片质量",
        "default": 100,
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        }
      },
      "t2i_r1_device_scale": {
        "type": "string",
        "description": "第一轮：分辨率等级",
        "options": ["normal", "high", "ultra"],
        "default": "ultra"
      },
      "t2i_r1_timeout": {
        "type": "int",
        "description": "第一轮：渲染超时 (ms)",
        "default": 50000
      },
      "t2i_r2_type": {
        "type": "string",
        "description": "第二轮：图片格式",
        "options": ["jpeg", "png"],
        "default": "jpeg"
      },
      "t2i_r2_quality": {
        "type": "int",
        "description": "第二轮：图片质量",
        "default": 80,
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        }
      },
      "t2i_r2_device_scale": {
        "type": "string",
        "description": "第二轮：分辨率等级",
        "options": ["normal", "high", "ultra"],
        "default": "high"
      },
      "t2i_r2_timeout": {
        "type": "int",
        "description": "第二轮：渲染超时 (ms)",
        "default": 100000
      }
    }
  },
  "web_viewer": {
    "description": "存档网页查看设置",
    "type": "object",
    "items": {
      "host": {
        "type": "string",
        "description": "存档网页监听地址",
        "default": "0.0.0.0",
        "hint": "默认监听所有网卡，网页会要求登录。若只想通过本机反代访问，可填 127.0.0.1。"
      },
      "port": {
        "type": "int",
        "description": "存档网页端口",
        "default": 8501,
        "slider": {
          "min": 1024,
          "max": 65535,
          "step": 1
        }
      },
      "public_base_url": {
        "type": "string",
        "description": "公网访问地址",
        "default": "",
        "hint": "例如 http://你的服务器IP:8501。留空时会回复 http://127.0.0.1:8501。"
      },
      "public_path_prefix": {
        "type": "string",
        "description": "反代路径前缀",
        "default": "",
        "hint": "如果网页挂在子路径下，例如 /Games/AIBot/，这里填 /Games/AIBot；根路径反代则留空。"
      }
    }
  },
  "performance": {
    "description": "性能设置",
    "type": "object",
    "items": {
      "max_concurrent_t2i": {
        "type": "int",
        "description": "最大 T2I 渲染并发数",
        "default": 1,
        "slider": {
          "min": 1,
          "max": 3,
          "step": 1
        }
      }
    }
  }
}
